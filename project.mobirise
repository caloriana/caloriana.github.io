    "sobremim.html": {
      "settings": {
        "title": "Sobre mim",
        "meta_descr": "Olá, bem-vindo(a) !\n\nSou a Carol, ex-Residente Cardiologista do HCFMUSP/InCor. Apesar de ter formação na área de saúde, resolvi explorar minha aptidão no universo da Tecnologia, Design e Web. Atuo também como professora, escritora, produtora de conteúdo personalizado e planos de cuidados holísticos adaptados às necessidades do público-alvo, prestando acompanhamento continuado para ajudar as pessoas em seus processos de despertar, trazendo clareza para o (auto)conhecimento e expansão de consciência.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "order": "1"
      },
      "components": [
        {
          "alias": false,
