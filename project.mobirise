    "index.html": {
      "settings": {
        "main": true,
        "title": "Home",
        "meta_descr": "Ajuda Inspirada by Carolina Lorusso. Início · Sobre mim · Produção de Conteúdos · Design · Websites · Contato. \nSou Escritora, Designer, Produtora de Conteúdo Digital e Websites.Com mais de 5 anos de experiência, tenho liderado uma ampla gama de projetos, incluindo empreendedorismo, redação de trabalhos acadêmicos, desenvolvimento de aulas e e-books,",
        "header_custom": "",
        "footer_custom": "",
        "html_before": ""
